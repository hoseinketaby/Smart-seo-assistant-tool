# Render PostgreSQL connection string (copy Internal Database URL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
SECRET_KEY=replace-with-a-long-random-value
ADMIN_SETUP_KEY=replace-with-a-random-setup-key
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-with-a-generated-fernet-key
# Only needed when upgrading databases with legacy API keys:
# ENCRYPTION_SALT=my-app-salt
# Optional for local HTTP development only (production uses HTTPS-secure cookies):
# FLASK_ENV=development
# TRUST_PROXY=1  # Only behind a trusted TLS-terminating proxy such as Render
